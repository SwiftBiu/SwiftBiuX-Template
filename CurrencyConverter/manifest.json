{
  "identifier": "com.swiftbiu.plugin.currencyconverter",
  "name": "Currency Converter",
  "author": "SwiftBiu",
  "description": "Real-time currency conversion with support for multiple currencies.",
  "version": "1.2.2",
  "icon": "banknote",
  "iconType": "sfSymbol",
  "actions": [
    {
      "title": "Convert Currency",
      "script": "script.js",
      "extensionKind": "textAction"
    }
  ],
  "permissions": [
    "network",
    "clipboardWrite",
    "notifications",
    "paste"
  ],
  "network": {
    "domains": [
      {
        "host": "api.frankfurter.app",
        "purpose": "Query real-time foreign exchange reference rates from the Frankfurter API.",
        "data": [
          "amount",
          "fromCurrency",
          "toCurrency"
        ]
      }
    ]
  },
  "ui": {
    "main": "ui/index.html"
  },
  "configuration": [],
  "extensionKind": "textAction"
}
