{
  "identifier": "com.SwiftBiu.searchplus",
  "name": {
    "en": "Search Plus",
    "zh": "搜索助手"
  },
  "author": "SwiftBiu",
  "description": {
    "en": "Select text and search with a custom keyword (e.g., 'Apple' + 'Official').",
    "zh": "选择文字并附带自定义关键字进行搜索（如：'苹果' + '官网'）。"
  },
  "version": "1.2.2",
  "icon": "plus.magnifyingglass",
  "iconType": "sfSymbol",
  "actions": [
    {
      "title": {
        "en": "Search with Keyword",
        "zh": "带关键字搜索"
      },
      "script": "script.js",
      "extensionKind": "textAction"
    }
  ],
  "permissions": [
    "network",
    "notifications"
  ],
  "network": {
    "domains": [
      { "host": "www.bing.com", "purpose": "Bing search queries" },
      { "host": "www.google.com", "purpose": "Google search queries" },
      { "host": "duckduckgo.com", "purpose": "DuckDuckGo search queries" },
      { "host": "www.baidu.com", "purpose": "Baidu search queries" },
      { "host": "github.com", "purpose": "GitHub code and repository search" },
      { "host": "stackoverflow.com", "purpose": "Stack Overflow technical search" },
      { "host": "www.youtube.com", "purpose": "YouTube video search" },
      { "host": "www.zhihu.com", "purpose": "Zhihu QA search" },
      { "host": "search.bilibili.com", "purpose": "Bilibili search" },
      { "host": "en.wikipedia.org", "purpose": "Wikipedia article lookup" },
      { "host": "www.reddit.com", "purpose": "Reddit community search" },
      { "host": "www.xiaohongshu.com", "purpose": "Xiaohongshu search" },
      { "host": "www.douyin.com", "purpose": "Douyin video search" },
      { "host": "www.tiktok.com", "purpose": "TikTok search" }
    ]
  },
  "configuration": [
    {
      "key": "search_engine",
      "label": {
        "en": "Search Engine",
        "zh": "搜索引擎"
      },
      "type": "option",
      "defaultValue": "https://www.bing.com/search?q={query}",
      "options": [
        {
          "label": {
            "en": "Bing",
            "zh": "必应"
          },
          "value": "https://www.bing.com/search?q={query}"
        },
        {
          "label": {
            "en": "Google",
            "zh": "谷歌"
          },
          "value": "https://www.google.com/search?q={query}"
        },
        {
          "label": "DuckDuckGo",
          "value": "https://duckduckgo.com/?q={query}"
        },
        {
          "label": {
            "en": "Baidu",
            "zh": "百度"
          },
          "value": "https://www.baidu.com/s?wd={query}"
        },
        {
          "label": "GitHub",
          "value": "https://github.com/search?q={query}"
        },
        {
          "label": "StackOverflow",
          "value": "https://stackoverflow.com/search?q={query}"
        },
        {
          "label": "YouTube",
          "value": "https://www.youtube.com/results?search_query={query}"
        },
        {
          "label": {
            "en": "Zhihu",
            "zh": "知乎"
          },
          "value": "https://www.zhihu.com/search?q={query}"
        },
        {
          "label": {
            "en": "Bilibili",
            "zh": "哔哩哔哩"
          },
          "value": "https://search.bilibili.com/all?keyword={query}"
        },
        {
          "label": {
            "en": "Wikipedia",
            "zh": "维基百科"
          },
          "value": "https://en.wikipedia.org/wiki/Special:Search?search={query}"
        },
        {
          "label": "Reddit",
          "value": "https://www.reddit.com/search/?q={query}"
        },
        {
          "label": {
            "en": "Xiaohongshu",
            "zh": "小红书"
          },
          "value": "https://www.xiaohongshu.com/search_result?keyword={query}"
        },
        {
          "label": {
            "en": "Douyin",
            "zh": "抖音"
          },
          "value": "https://www.douyin.com/search/{query}"
        },
        {
          "label": "TikTok",
          "value": "https://www.tiktok.com/search?q={query}"
        },
        {
          "label": {
            "en": "Custom",
            "zh": "自定义"
          },
          "value": "custom"
        }
      ],
      "group": "General"
    },
    {
      "key": "custom_engine_url",
      "label": {
        "en": "Custom Engine URL",
        "zh": "自定义引擎 URL"
      },
      "type": "string",
      "placeholder": "https://example.com/search?q={query}",
      "description": {
        "en": "Used only if 'Custom' is selected. Use {query} as placeholder.",
        "zh": "仅在选择“自定义”时生效。使用 {query} 作为占位符。"
      },
      "group": "General"
    },
    {
      "key": "keyword",
      "label": {
        "en": "Keyword",
        "zh": "关键字"
      },
      "type": "string",
      "defaultValue": "官网",
      "placeholder": "e.g. 官网",
      "group": "Search"
    },
    {
      "key": "keyword_position",
      "label": {
        "en": "Keyword Position",
        "zh": "关键字位置"
      },
      "type": "option",
      "defaultValue": "suffix",
      "options": [
        {
          "label": {
            "en": "Suffix (Text + Keyword)",
            "zh": "后缀 (文字 + 关键字)"
          },
          "value": "suffix"
        },
        {
          "label": {
            "en": "Prefix (Keyword + Text)",
            "zh": "前缀 (关键字 + 文字)"
          },
          "value": "prefix"
        }
      ],
      "group": "Search"
    }
  ],
  "extensionKind": "textAction"
}
