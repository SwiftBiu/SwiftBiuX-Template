{
  "identifier": "com.swiftbiux.apify-video-downloader",
  "name": {
    "en": "Apify Video Downloader",
    "zh": "Apify 视频下载器"
  },
  "author": "SwiftBiu Community Template",
  "description": {
    "en": "Download a selected public video in one click through independent Apify Actors, using defaults managed in SwiftBiu settings.",
    "zh": "通过独立的 Apify Actor 一键下载选中的公开视频，画质、费用与保存行为统一在 SwiftBiu 设置中管理。"
  },
  "version": "1.3.2",
  "icon": "square.and.arrow.down",
  "iconType": "sfSymbol",
  "extensionKind": "textAction",
  "permissions": [
    "network",
    "localFileWrite",
    "notifications"
  ],
  "network": {
    "domains": [
      {
        "host": "api.apify.com",
        "purpose": "Start and monitor the selected third-party Apify video downloader Actor and read its result dataset.",
        "data": [
          "selected public video URL",
          "actor input",
          "run status"
        ],
        "usesCredential": "User-provided Apify API token"
      }
    ]
  },
  "configuration": [
    {
      "key": "apify_token",
      "label": {
        "en": "Apify API Token",
        "zh": "Apify API Token"
      },
      "type": "secure",
      "placeholder": {
        "en": "apify_api_...",
        "zh": "apify_api_..."
      },
      "description": {
        "en": "Your own Apify token. It is stored by SwiftBiu as a secure configuration value and sent only to api.apify.com.",
        "zh": "你自己的 Apify Token。由 SwiftBiu 作为安全配置保存，仅发送给 api.apify.com。"
      },
      "group": {
        "en": "Authentication",
        "zh": "身份验证"
      }
    },
    {
      "key": "youtube_quality",
      "label": {
        "en": "YouTube Quality",
        "zh": "YouTube 默认画质"
      },
      "type": "option",
      "defaultValue": "720p",
      "description": {
        "en": "The YouTube Actor creates one downloadable file in this preferred quality.",
        "zh": "YouTube Actor 会按该首选画质生成一个可下载文件。"
      },
      "options": [
        { "label": { "en": "Best Available", "zh": "最佳可用画质" }, "value": "best" },
        { "label": "1080p", "value": "1080p" },
        { "label": "720p", "value": "720p" },
        { "label": "480p", "value": "480p" },
        { "label": "360p", "value": "360p" },
        { "label": { "en": "Audio Only", "zh": "仅音频" }, "value": "audio_only" }
      ],
      "group": {
        "en": "Download Defaults",
        "zh": "下载默认值"
      }
    },
    {
      "key": "media_preference",
      "label": {
        "en": "Media Selection",
        "zh": "媒体选择策略"
      },
      "type": "option",
      "defaultValue": "automatic",
      "description": {
        "en": "When an Actor returns multiple files, automatically choose the best match or prefer video/audio.",
        "zh": "当 Actor 返回多个文件时，自动选择最佳结果，或优先选择视频/音频。"
      },
      "options": [
        { "label": { "en": "Automatic Best Match", "zh": "自动选择最佳结果" }, "value": "automatic" },
        { "label": { "en": "Prefer Video", "zh": "优先视频" }, "value": "video" },
        { "label": { "en": "Prefer Audio", "zh": "优先音频" }, "value": "audio" }
      ],
      "group": {
        "en": "Download Defaults",
        "zh": "下载默认值"
      }
    },
    {
      "key": "max_charge_usd",
      "label": {
        "en": "Maximum Charge Per Run",
        "zh": "单次任务最高费用"
      },
      "type": "option",
      "defaultValue": "0.25",
      "description": {
        "en": "Passed to Apify as maxTotalChargeUsd. The run is capped to one paid dataset item as an additional safety guard.",
        "zh": "通过 maxTotalChargeUsd 传给 Apify，并额外把单次付费 Dataset 结果限制为 1 条。"
      },
      "options": [
        { "label": "$0.05", "value": "0.05" },
        { "label": "$0.10", "value": "0.10" },
        { "label": "$0.25", "value": "0.25" },
        { "label": "$0.50", "value": "0.50" },
        { "label": "$1.00", "value": "1.00" }
      ],
      "group": {
        "en": "Cost & Safety",
        "zh": "费用与安全"
      }
    },
    {
      "key": "download_directory",
      "label": {
        "en": "Download Folder",
        "zh": "下载目录"
      },
      "type": "directory",
      "description": {
        "en": "Default save folder. If it is empty, the first download asks once and remembers the selected folder here.",
        "zh": "默认保存目录。留空时首次下载会询问一次，并把所选目录记到这里。"
      },
      "group": {
        "en": "Download Defaults",
        "zh": "下载默认值"
      }
    }
  ],
  "actions": [
    {
      "id": "downloadVideoWithApify",
      "title": {
        "en": "Download Video",
        "zh": "下载视频"
      },
      "description": {
        "en": "Immediately detect the selected platform and download using the defaults in extension settings.",
        "zh": "立即识别选中链接的平台，并按扩展设置中的默认参数下载。"
      },
      "icon": "square.and.arrow.down",
      "script": "script.js",
      "extensionKind": "textAction",
      "rules": {
        "regex": "https?://\\S+"
      }
    }
  ]
}
